# Copy to .env locally; do not commit .env or share these secrets.
# Generate SESSION_SECRET using a cryptographically secure random value of 32+ characters.
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-with-a-unique-random-password-at-least-16-characters
